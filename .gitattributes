# Build scripts, patches and configuration must use LF line endings.
# A CRLF line ending in a patch file makes "git apply" fail, and the U-Boot
# boot script and shell scripts break with CRLF.
* text=auto eol=lf

*.patch text eol=lf
*.sh   text eol=lf
*.ush  text eol=lf
*.cfg  text eol=lf
*.conf text eol=lf
*.config text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.defconfig text eol=lf
