# U-Boot configuration for LCKFB Taishan Pi (RK3566)
#
# Applied on top of the upstream U-Boot board defconfig
# (configs/lckfb-tspi-rk3566_defconfig, which is mainline since U-Boot v2026.04).

# The Taishan Pi exposes a user-controllable RGB LED (status-red/status-green/
# status-blue) on GPIO1 PB2/PB1/PB0, active low.
CONFIG_LED=y
CONFIG_LED_GPIO=y
CONFIG_CMD_LED=y

# eMMC access on RK3566 must use HS200. DDR52 mode is known to corrupt writes
# on RK356x, see the Home Assistant Green board patch in upstream HAOS:
#   "green: Do not use eMMC DDR52 mode, enable HS200"
# The same applies to the Taishan Pi eMMC.
CONFIG_MMC_HS200_SUPPORT=y
CONFIG_SPL_MMC_HS200_SUPPORT=y
