# Kernel options for LCKFB Taishan Pi (RK3566)
#
# Derived from the Home Assistant Green (RK3566) board config shipped in
# home-assistant/operating-system: buildroot-external/board/nabucasa/green/kernel.config
# Adjusted for Taishan Pi specifics (RK809 PMIC, ADC recovery key, AP6212 WiFi/BT).

# The Taishan Pi uses the RK809 PMIC, whose on-board RTC differs from RK808.
# CONFIG_RTC_DRV_RK808 is not set

# Use the PWM fan / thermal bang-bang governor like the RK3566 Green board.
# CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

CONFIG_THERMAL_GOV_BANG_BANG=y
CONFIG_SENSORS_GPIO_FAN=y

# The Taishan Pi recovery button is wired to the SARADC (ADC key), not to a
# GPIO. Keep the generic GPIO keyboard driver enabled anyway so that the
# optional 40-pin header buttons keep working if the user wires them up.
CONFIG_KEYBOARD_GPIO=y
CONFIG_KEYBOARD_GPIO_POLLED=y

# Rockchip eMMC (sdhci) and SD card (sdmmc0) controllers on RK3566.
CONFIG_MMC_SDHCI_OF_DWCMSHC=y

# Rockchip DW watchdog is not used on the Taishan Pi.
# CONFIG_DW_WATCHDOG is not set

# Required by the AP6212 (BCM4329) WiFi/BT combo on SDIO.
CONFIG_MMC_SDHCI_SDMA=y
